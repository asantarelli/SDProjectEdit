# Normalizar finales de línea en el repo, con checkout nativo por plataforma.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.slnx      text
*.props     text
*.targets   text
*.md        text
*.yml       text
*.json      text

*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.sh        text eol=lf

*.png       binary
*.ico       binary
*.exe       binary
