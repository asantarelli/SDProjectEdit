<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Subsistema consola a propósito: el modo CLI tiene que redirigir salida y devolver exit
         codes como cualquier herramienta de build. Al entrar en modo GUI se libera la consola. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SDProjectEdit.App</RootNamespace>
    <AssemblyName>SDProjectEdit</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>SDProjectEdit</Product>
    <AssemblyTitle>Editor de proyectos multi-DLL de Clarion</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDProjectEdit.Core\SDProjectEdit.Core.csproj" />
  </ItemGroup>

</Project>
